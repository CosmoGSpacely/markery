#!/usr/bin/env python3
"""
Interactive patent-trademark pair review.
Run from project root with venv active.

Usage:
  scripts/review                        # information-systems project, score >= 0.5
  scripts/review --min-score 0.65       # tighter threshold
  scripts/review --mark VI-DEX          # single trademark
  scripts/review patent-images          # different project

Keys: Y = confirm   N = skip   Q = quit
"""

from __future__ import annotations

import argparse
import json
import sys
import termios
import tty
from datetime import date
from pathlib import Path

import duckdb

ROOT = Path(__file__).parent.parent
sys.path.insert(0, str(ROOT))

from match.score import date_score, class_score

PROJECTS_DIR = ROOT / "projects"

# ── Terminal helpers ──────────────────────────────────────────────────────────

def getch() -> str:
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        return sys.stdin.read(1).lower()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def wordwrap(text: str, width: int) -> list[str]:
    if not text:
        return ["—"]
    words, lines, line = text.split(), [], []
    for word in words:
        if line and sum(len(w) + 1 for w in line) + len(word) > width:
            lines.append(" ".join(line))
            line = [word]
        else:
            line.append(word)
    if line:
        lines.append(" ".join(line))
    return lines


# ── Database helpers ──────────────────────────────────────────────────────────

def fetch_tm(conn, serial: str) -> dict:
    sn = str(serial)
    cf  = conn.execute("SELECT mark_draw_cd FROM case_file WHERE serial_no = ?", [sn]).fetchone()
    st  = conn.execute(
        "SELECT statement_text FROM statement WHERE serial_no = ? LIMIT 1", [sn]
    ).fetchone()
    cl  = conn.execute(
        "SELECT first_use_any_dt, first_use_com_dt FROM classification WHERE serial_no = ?", [sn]
    ).fetchone()
    mcs = conn.execute(
        "SELECT first_use_dt, goods_desc FROM mark_case_status WHERE serial_no = ?", [sn]
    ).fetchone()

    goods = (st[0] if st else (mcs[1] if mcs else None)) or "—"

    first_use = None
    if cl and (cl[0] or cl[1]):
        fu = cl[0] or cl[1]
        first_use = fu.isoformat() if hasattr(fu, "isoformat") else str(fu)
    elif mcs and mcs[0]:
        first_use = str(mcs[0])

    draw_cd = cf[0] if cf else "—"
    draw_desc = {
        "1": "typed word — no image",
        "3": "design mark",
        "4": "standard character",
        "5": "stylized — has image",
    }.get(draw_cd[0] if draw_cd and draw_cd != "—" else "", "")
    draw_str = f"{draw_cd}  ({draw_desc})" if draw_desc else draw_cd

    return {"goods": goods, "first_use": first_use or "—", "draw": draw_str}


def fetch_patent(conn, patent_no: str) -> dict:
    p   = conn.execute("SELECT app_dt FROM patents WHERE patent_no = ?", [patent_no]).fetchone()
    inv = conn.execute(
        "SELECT inventor_name FROM patent_inventors WHERE patent_no = ? LIMIT 2", [patent_no]
    ).fetchall()
    cls = conn.execute(
        "SELECT DISTINCT cpc_full FROM patent_classes WHERE patent_no = ?", [patent_no]
    ).fetchall()
    return {
        "app_dt":    str(p[0]) if p and p[0] else "—",
        "inventors": "  ".join(r[0].title() for r in inv) if inv else "—",
        "cpc_full":  "  ".join(r[0] for r in cls) if cls else "—",
    }


def load_confirmed(path: Path) -> set[tuple]:
    if not path.exists():
        return set()
    return {
        (json.loads(l)["patent_no"], json.loads(l)["trademark_serial"])
        for l in path.read_text().splitlines()
        if l.strip()
    }


def write_confirmed(path: Path, entry: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as f:
        f.write(json.dumps(entry) + "\n")


# ── Display ───────────────────────────────────────────────────────────────────

def display(cand: dict, tm: dict, pat: dict, idx: int, total: int,
            entity_names: set[str]) -> None:
    W = 74
    rule = "─" * W

    mark = cand["trademark"]
    is_company = any(
        n.upper() in mark.upper() or mark.upper() in n.upper()
        for n in entity_names
    )
    flag = "  ⚠ company-name mark" if is_company else ""

    try:
        g  = date.fromisoformat(cand["patent_grant_dt"])
        tf = date.fromisoformat(cand["tm_filing_dt"])
        days = (tf - g).days
        gap_str = (
            f"{days} days after grant" if days >= 0
            else f"{abs(days)} days BEFORE grant ⚠"
        )
        ds = date_score(g, tf)
    except Exception:
        gap_str, ds = "—", 0.0
    cs    = class_score(cand["cpc_classes"])
    score = cand["score"]

    print(f"\n{rule}")
    print(f" {idx}/{total}   {mark}  ←→  {cand['patent_no']}   [{score:.2f}]{flag}")
    print(rule)

    def row(label: str, value: str) -> None:
        print(f"  {label:<13}{value}")

    print("\n  TRADEMARK")
    row("Mark",        mark)
    row("Serial",      str(cand["trademark_serial"]))
    row("Filed",       cand["tm_filing_dt"])
    row("First use",   tm["first_use"])
    row("Owner",       (cand["tm_owner"] or "—"))
    row("Draw code",   tm["draw"])
    goods_lines = wordwrap(tm["goods"], W - 15)
    row("Goods", goods_lines[0])
    for extra in goods_lines[1:]:
        print(f"  {'':13}{extra}")

    print("\n  PATENT")
    row("Patent",      cand["patent_no"])
    row("Granted",     cand["patent_grant_dt"])
    row("App date",    pat["app_dt"])
    row("Assignee",    cand["patent_assignee"] or "—")
    row("Inventors",   pat["inventors"])
    title_lines = wordwrap(cand["patent_title"], W - 15)
    row("Title", title_lines[0])
    for extra in title_lines[1:]:
        print(f"  {'':13}{extra}")
    cpc_lines = wordwrap(pat["cpc_full"], W - 15)
    row("CPC", cpc_lines[0])
    for extra in cpc_lines[1:]:
        print(f"  {'':13}{extra}")

    print(f"\n  Date gap:  {gap_str}")
    print(f"  Score:     {score:.4f}  (date {ds:+.2f}  class {cs:.2f})\n")


# ── Main ──────────────────────────────────────────────────────────────────────

def main() -> None:
    ap = argparse.ArgumentParser(description="Review patent-trademark candidate pairs")
    ap.add_argument("project",      nargs="?", default="information-systems")
    ap.add_argument("--min-score",  type=float, default=0.5)
    ap.add_argument("--mark",       help="Filter to a specific trademark name (case-insensitive)")
    args = ap.parse_args()

    project_dir    = PROJECTS_DIR / args.project
    candidates_path = project_dir / "matches" / "candidates.jsonl"
    confirmed_path  = project_dir / "matches" / "confirmed.jsonl"

    if not candidates_path.exists():
        print(f"No candidates.jsonl at {candidates_path}")
        sys.exit(1)

    conn_tm  = duckdb.connect(str(ROOT / "trademarks.duckdb"), read_only=True)
    conn_pat = duckdb.connect(str(ROOT / "patents.duckdb"),    read_only=True)
    conn_ent = duckdb.connect(str(ROOT / "entities.duckdb"),   read_only=True)

    entity_names = {
        r[0] for r in conn_ent.execute("SELECT canonical_name FROM company_entity").fetchall()
    }

    already_confirmed = load_confirmed(confirmed_path)
    all_cands = [
        json.loads(l) for l in candidates_path.read_text().splitlines() if l.strip()
    ]

    # Filter, deduplicate on (patent_no, trademark_serial), sort by score desc
    seen, queue = set(), []
    for c in sorted(all_cands, key=lambda x: -x["score"]):
        key = (c["patent_no"], c["trademark_serial"])
        if (
            key not in seen
            and key not in already_confirmed
            and c["score"] >= args.min_score
            and (args.mark is None or args.mark.upper() in c["trademark"].upper())
        ):
            seen.add(key)
            queue.append(c)

    total = len(queue)
    if total == 0:
        print(f"No candidates to review (score ≥ {args.min_score}, project: {args.project}).")
        sys.exit(0)

    print(f"\nReviewing {total} candidates  ·  project: {args.project}"
          f"  ·  score ≥ {args.min_score}")
    print("Y = confirm   N = skip   Q = quit")

    confirmed_n = skipped_n = 0

    try:
        for idx, cand in enumerate(queue, 1):
            tm  = fetch_tm(conn_tm,  str(cand["trademark_serial"]))
            pat = fetch_patent(conn_pat, cand["patent_no"])
            display(cand, tm, pat, idx, total, entity_names)

            print("  [Y]es  [N]o  [Q]uit  → ", end="", flush=True)
            ch = getch()
            print(ch.upper())

            if ch == "q":
                break
            elif ch == "y":
                print("  Note (Enter to leave blank): ", end="", flush=True)
                note = input().strip()
                write_confirmed(confirmed_path, {
                    "patent_no":        cand["patent_no"],
                    "trademark_serial": cand["trademark_serial"],
                    "trademark":        cand["trademark"],
                    "entity_id":        cand["entity_id"],
                    "entity":           cand["entity"],
                    "type":             "product",
                    "note":             note,
                })
                confirmed_n += 1
                print("  ✓ Written to confirmed.jsonl")
            elif ch == "n":
                skipped_n += 1

    except KeyboardInterrupt:
        print("\n  (interrupted)")

    print(f"\nSession: {confirmed_n} confirmed  ·  {skipped_n} skipped  ·  {total - confirmed_n - skipped_n} unreviewed\n")

    conn_tm.close()
    conn_pat.close()
    conn_ent.close()


if __name__ == "__main__":
    main()
